<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ext" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base.setup.ext</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="document_layout_setting" position="after">
                <setting id="teleprince_logo" string="Teleprince Logo" help="Logos used in document layouts">
                    <div class="w-50 row">
                        <span class="d-block w-75 py-2">Teleprince Logo</span>
                        <field name="teleprince_logo" widget="image" class="oe_avatar"/>
                    </div>
                    <div class="w-50 row mt-1">
                        <span class="d-block w-75 py-2">Teleprince &amp; B&amp;O Logo</span>
                        <field name="b_and_o_logo" widget="image" class="oe_avatar"/>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>