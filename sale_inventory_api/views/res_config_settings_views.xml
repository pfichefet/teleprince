<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.B.and.O.api</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="BandO" string="B&amp;O" name="b_and_o_api" groups="sale_inventory_api.b_and_o_group_manager">
                    <block title="REST API" id="rest_api">
                        <setting id="activate_bo_api" title="Activate the Rest API">
                            <field name="b_and_o_api_active"/>
                        </setting>
                        <setting id="bo_api_parameters" title="API Parameters" invisible="not b_and_o_api_active">
                            <div class="text-muted" name="bo_base_url">
                                <p>Base URL used to send API REST requests</p>
                                <field name="b_and_o_base_url"/>
                            </div>
                            <div class="text-muted" name="bo_test_url">
                                <p>Test URL used to send API REST requests</p>
                                <field name="b_and_o_test_url"/>
                            </div>
                            <div class="text-muted" name="bo_key">
                                <p>API Key used in the request to be authenticated.</p>
                                <field name="b_and_o_api_key"/>
                            </div>
                            <div class="text-muted" name="bo_id">
                                <p>API ID used in the request to be authenticated.</p>
                                <field name="b_and_o_api_id"/>
                            </div>
                            <div class="text-muted" name="bo_store">
                                <p>API Store ID used in the request (only if not defined on the warehouse).</p>
                                <field name="b_and_o_api_store"/>
                            </div>
                            <div class="text-muted" name="bo_start_date">
                                <p>Odoo will send Sale data starting from this date.</p>
                                <field name="b_and_o_api_start_date"/>
                            </div>
                            <div class="text-muted" name="bo_time_delta">
                                <p>Specify the number of days Odoo should wait before sending sales data.
                                    For example, if a sales order is dated as day X, Odoo will send the data on day X + time_delta.</p>
                                <field name="b_and_o_api_time_delta"/>
                            </div>
                            <div class="text-muted" name="bo_env">
                                <p>Defined the environment we used to send data, B&amp;O will consider only request send to a Production environment.</p>
                                <field name="b_and_o_api_environment"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_b_and_o_api_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'b_and_o_api', 'bin_size': False}</field>
    </record>

</odoo>
