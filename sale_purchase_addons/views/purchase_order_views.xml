<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_view" model="ir.ui.view">
        <field name="name">purchase.order.form.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="sale_partner_id"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_list_view" model="ir.ui.view">
        <field name="name">purchase.order.list.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="sale_partner_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
