<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="task_custom_report_no_ts" model="ir.actions.report">
            <field name="name">Task Report Without Timesheet</field>
            <field name="model">project.task</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">task_report_no_timesheet.worksheet_custom_no_ts</field>
            <field name="report_file">task_report_no_timesheet.worksheet_custom_no_ts</field>
            <field name="print_report_name">'Worksheet %s - %s' % (object.name, object.partner_id.name)</field>
            <field name="binding_model_id" ref="project.model_project_task"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
