<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_form_sale_line" model="ir.ui.view">
        <field name="name">project.task.form.sale.line</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="project_partner_id" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="sharing_project_task_view_form_sale_line" model="ir.ui.view">
        <field name="name">sharing.project.task.form.sale.line</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_sharing_project_task_view_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="project_partner_id" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="quick_create_task_form" model="ir.ui.view">
        <field name="name">project.quick.create.task.form.date</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.quick_create_task_form"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="after">
                <field name="planned_date_begin" widget="daterange" options='{"related_end_date": "date_deadline"}'/>
                <field name="date_deadline" widget="daterange" options='{"related_start_date": "planned_date_begin"}'/>
            </field>
        </field>
    </record>

    <record id="fsm_task_form" model="ir.ui.view">
        <field name="name">project.fsm.task.form.date</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="industry_fsm.view_task_form2_inherit"/>
        <field name="arch" type="xml">
            <div name="partner_phone" position="after">
                <field name="delivery_partner_id" context="{'show_address': 1, 'show_address_if_fsm': 1, 'res_partner_search_mode': 'customer'}" invisible="not is_fsm"/>
            </div>
        </field>
    </record>

</odoo>
