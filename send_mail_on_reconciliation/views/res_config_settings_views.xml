<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pay_invoice_online_setting_container']" position="inside">
                <setting id="email_on_customer_invoice_reconciliation" title="Email on customer invoice reconciliation" help="As soon as a customer invoice is marked as paid, an email is sent to inform the customer that their payment has been received.
                            However, emails are not sent for invoices generated through the point-of-sale application.">
                    <field name="send_mail_invoice_reconciliation"/>
                    <field name="invoice_reconciliation_mail_template_id" required="send_mail_invoice_reconciliation"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>